{
  "name": "noesisai",
  "version": "0.0.1",
  "description": "The self-evolving agent harness for tinkerers.",
  "keywords": [
    "agent",
    "ai",
    "coding-agent",
    "self-improvement",
    "terminal"
  ],
  "homepage": "https://github.com/SwarnimWalavalkar/noesis#readme",
  "bugs": {
    "url": "https://github.com/SwarnimWalavalkar/noesis/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SwarnimWalavalkar/noesis.git"
  },
  "bin": {
    "noesis": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "build:release": "vite build --config vite.release.config.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "dev": "./scripts/noesis-dev",
    "dev:install": "./scripts/install-noesis-dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "package:smoke": "node scripts/test-package.mjs",
    "prepack": "npm run build:release",
    "release:verify": "node scripts/verify-release.mjs",
    "start": "tsx apps/noesis/src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.85.0",
    "@earendil-works/pi-ai": "0.85.0",
    "@earendil-works/pi-coding-agent": "0.85.0",
    "@earendil-works/pi-server": "0.85.0",
    "@earendil-works/pi-tui": "0.85.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "acorn": "8.18.0",
    "proper-lockfile": "4.1.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.79.0",
    "@types/node": "24.10.1",
    "oxfmt": "0.64.0",
    "oxlint": "1.79.0",
    "tsx": "4.23.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@10.29.3",
  "pnpm": {
    "overrides": {
      "brace-expansion@5.0.8": "5.0.9",
      "fast-uri@3.1.5": "3.1.6",
      "qs@6.15.3": "6.16.0",
      "undici@8.5.0": "8.9.0"
    }
  }
}
